# required
NAGOMI_CORE_URL=http://localhost:55555
NAGOMI_API_KEY=
NAGOMI_MCP_USER_ID=                         # one instance per user
NAGOMI_MCP_BASE_URL=https://mcp.example.com # public URL

# optional
NAGOMI_MCP_LISTEN_ADDRESS=127.0.0.1:55553
NAGOMI_MCP_LOG_LEVEL=info                   # debug, info, warn, error
NAGOMI_MCP_LOG_FORMAT=text                  # text or json
